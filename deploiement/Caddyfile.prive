# Caddy, version démo privée : le même musée, derrière un mot de passe partagé.
# Activée par CADDYFILE=Caddyfile.prive dans .env (voir DEPLOIEMENT.md, « Une démo privée »).
{$DOMAINE} {
	basic_auth {
		{env.ACCES_NOM} {env.ACCES_EMPREINTE}
	}
	encode zstd gzip
	reverse_proxy musee:8787
}

# l'adresse avec « www. » renvoie vers l'adresse principale
www.{$DOMAINE} {
	redir https://{$DOMAINE}{uri} permanent
}
