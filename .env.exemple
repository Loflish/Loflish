# Nos mots mémoriaux — réglages du serveur de production (docker compose).
# Copier ce fichier en « .env » (même dossier), le remplir, ne jamais le publier.

# L'adresse du musée, sans https:// (le nom de domaine doit pointer vers ce serveur)
DOMAINE=nosmotsmemoriaux.org

# Mot de passe de la base : lettres et chiffres seulement. Pour en créer un : openssl rand -hex 24
POSTGRES_PASSWORD=

# Secret qui protège les connexions. Pour en créer un : openssl rand -hex 32
# (le changer déconnecte tout le monde, sans rien perdre)
SECRET=

# Les adresses e-mail de l'équipe qui reçoivent le rôle d'administration (séparées par des virgules)
ADMIN_EMAILS=

# L'envoi des e-mails (liens de connexion). Adresse SMTP de ton fournisseur, par exemple :
#   smtps://utilisateur:motdepasse@smtp-relay.brevo.com:465
# Sans SMTP, personne ne peut se connecter en production (le lien n'est écrit que dans le journal du serveur).
SMTP_URL=
MAIL_FROM=Nos mots mémoriaux <bonjour@nosmotsmemoriaux.org>

# Où garder les photos, sons, vidéos et documents déposés :
#   disque : sur ce serveur (volume « fichiers », sauvegardé chaque nuit) — simple, pour commencer
#   s3     : chez un stockage compatible S3 (Scaleway, OVH, Cloudflare R2, Backblaze…) — pour grandir
STOCKAGE=disque
S3_BUCKET=
S3_REGION=fr-par
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Combien de jours garder les sauvegardes quotidiennes
SAUVEGARDE_JOURS=30
