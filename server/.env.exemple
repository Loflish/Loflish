# Réglages du serveur pour travailler sur ton ordinateur (npm run dev dans server/).
# Copier en « server/.env ». En production, c'est le fichier .env à la racine qui compte (voir DEPLOIEMENT.md).

PORT=8787
SITE_URL=http://localhost:5173
DATABASE_URL=postgres://postgres@localhost:5432/nmm
ADMIN_EMAILS=toi@exemple.fr
# Sans SMTP, le lien de connexion s'affiche dans le terminal et sur la page (hors production).
SMTP_URL=
STOCKAGE=disque
STOCKAGE_DOSSIER=./donnees/fichiers
SITE_DOSSIER=../dist
