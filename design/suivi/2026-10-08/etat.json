  "lot04": [
    {
      "candidate_proposee": 1,
      "nom": "Réserves diffuses",
      "avis_createur": "garder sous condition de singularite par rapport aux autres matieres",
      "singularite_catalogue_verifiee": false,
      "remplacement_valide": false,
      "integre": false,
      "original": "matieres/lot04/reserves-diffuses-original.png",
      "sha256": "4dedda15b73e0d892708dd6a2c9708b3ccba0a47ba516e719c62939fed9b93d3",
      "brief": "Un papier absorbant parcouru par trois ou quatre réserves claires inégales et décentrées. Le pigment contourne ces passages avec des bords doux et légèrement fibreux.",
      "difference_recherchee": "La structure serait donnée par les espaces clairs dans une surface continue. Les fibres 15 resteraient des filaments, le voile 70 des couches superposées et l’encre 50 des chemins plus sombres.",
      "risque": "Les réserves peuvent devenir trop blanches ou trop dessinées. Je rechercherais des transitions absorbées, sans contour net ni effet de découpage.",
      "prompt": "Create one abstract watercolor and handmade textile material swatch, centered face-on macro view, gently irregular circular silhouette occupying about 80 percent of a square canvas. Neutral grayscale only. Matte porous surface, absorbed pigment, delicate quiet light reserves, soft even diffuse illumination. Preserve readable internal structure at small website bubble sizes. No sphere, glossy reflection, hard vector outline, cast shadow, colored background, recognizable plant, leaf, animal, celestial object, text, ornament, border or embroidery. Plain white background outside the swatch. The website applies its GRIS palette and embroidered perimeter thread. Produce only the material surface. The defining structure is three or four unequal off-center soft light reserves in a continuous watercolor paper wash, with irregular elongated edges and faint paper fibers at the absorbed pigment boundary. Uneven spacing, no repeated pattern. The light areas are shallow low-pigment regions, not physical holes or raised patches. Do not use a central white hole, complete ring, concentric circles, plant silhouette, stacked transparent sheets, dramatic tearing or hard cutout edges. Keep the reserves gently visible as asymmetrical light passages."
    },
    {
      "candidate_proposee": 19,
      "nom": "Feutre nuagé",
      "avis_createur": "garder sous condition de singularite par rapport aux autres matieres",
      "singularite_catalogue_verifiee": false,
      "remplacement_valide": false,
      "integre": false,
      "original": "matieres/lot04/feutre-nuage-original.png",
      "sha256": "f5b444ff79c3f92b6f6ddf5c22bbdef5c7723f6fdb5cfcf0dd304c08ef4894d2",
      "brief": "Un feutre mat à fibres très courtes, réunies en quelques amas souples et irréguliers. Le pigment s’accroche à ces amas ; des zones moins denses laissent respirer la surface.",
      "difference_recherchee": "La signature serait une surface dense et poreuse à fibres courtes. La 15 conserverait ses longs fils visibles, la 95 ses larges plis et la 85 son relief de papier.",
      "risque": "Un feutre trop uniforme perdrait sa singularité ; un relief trop fort rendrait la bulle lourde. Je viserais quelques différences de densité, avec une lumière plate.",
      "prompt": "Create one abstract watercolor and handmade textile material swatch, centered face-on macro view, gently irregular circular silhouette occupying about 80 percent of a square canvas. Neutral grayscale only. Matte porous surface, absorbed pigment, delicate quiet light reserves, soft even diffuse illumination. Preserve readable internal structure at small website bubble sizes. No sphere, glossy reflection, hard vector outline, cast shadow, colored background, recognizable plant, leaf, animal, celestial object, text, ornament, border or embroidery. Plain white background outside the swatch. The website applies its GRIS palette and embroidered perimeter thread. Produce only the material surface. The defining structure is softly needle-felted cotton with very short compressed fibers, shallow irregular clustered tufts in only a few uneven regions, and more open porous transitions between them. A continuous low-relief felt surface, with pigment caught in the short-fiber clusters. No long filament network, woven grid, lace, fluffy fur, deep plush piles, crumpled folds, paper embossing, uniform stipple, smooth cloudy gradient or directional shiny highlight. Make the short-fiber clustered structure readable without hardening the material."
    },
    {
      "candidate_proposee": 76,
      "nom": "Pigment sédimenté",
      "avis_createur": "garder sous condition de singularite par rapport aux autres matieres",
      "singularite_catalogue_verifiee": false,
      "remplacement_valide": false,
      "integre": false,
      "original": "matieres/lot04/pigment-sedimente-original.png",
      "sha256": "259f1330a0fce7121739267ebb48616acfb8ea604fed3c5af6fe5af04927435a",
      "brief": "Des petits grains mats se regroupent en deux ou trois zones irrégulières dans le papier. De fins dépôts suivent les creux de ces zones, entre des passages plus calmes.",
