{
  "name": "nos-mots-memoriaux",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:en-ligne": "vite --mode en-ligne",
    "build": "tsc -b && vite build",
    "build:en-ligne": "tsc -b && vite build --mode en-ligne",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "serveur": "npm --prefix server run dev",
    "serveur:test": "npm --prefix server test",
    "lint": "eslint .",
    "format": "prettier --write src server/src server/test scripts",
    "format:check": "prettier --check src server/src server/test scripts",
    "test:site": "vitest run",
    "test": "vitest run && npm --prefix server test",
    "verifier": "node scripts/verifier.mjs"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/ibm-plex-sans-devanagari": "^5.3.0",
    "@fontsource/ibm-plex-sans-hebrew": "^5.3.0",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "lighthouse": "^13.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
